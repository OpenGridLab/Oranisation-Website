# Deployment URL
NEXT_PUBLIC_SITE_URL=https://opengridlabs.org

# Optional: GitHub Personal Access Token to raise GitHub API rate limits (from 60 to 5,000 req/hr)
# The site works completely fine without this using public API and fallbacks.
GITHUB_TOKEN=

# Optional: Email Service for Contact Form
# If not configured, visitors can still copy or click connect.opengridlab@gmail.com directly.
NODEMAILER_HOST=smtp.gmail.com
NODEMAILER_PORT=587
NODEMAILER_USER=connect.opengridlab@gmail.com
NODEMAILER_PASS=your-app-password
USER_MAILER="OpenGridLabs Contact"
USER_TO=connect.opengridlab@gmail.com
